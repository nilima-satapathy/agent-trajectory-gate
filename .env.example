# OpenAI-compatible API (default: Groq free tier)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
# Prefer a lighter tool-calling free model (better daily token headroom)
OPENAI_MODEL=llama-3.1-8b-instant
# Fallback candidates tried automatically on 429: see src/llm/client.py


# SUT
SUT_MODE=fixture
# SUT_MODE=live

# L3 LLM trajectory judge (scores tool path; needs API key; default on)
JUDGE_ENABLED=true


# Agent loop budget
MAX_TOOL_STEPS=6

# Free-tier meter (demo defaults; adjust to your quota story)
FREE_TIER_DAILY_TOKEN_BUDGET=100000
